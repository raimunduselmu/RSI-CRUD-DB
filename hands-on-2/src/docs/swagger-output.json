  "definitions": {
    "StallInput": {
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "number",
          "example": 2
        },
        "name": {
          "type": "string",
          "example": "Warung Baru"
        },
        "category": {
          "type": "string",
          "example": "Nasi"
        },
        "location": {
          "type": "string",
          "example": "Kantin FK"
        },
        "description": {
          "type": "string",
          "example": ""
        }
      },
      "required": [
        "ownerId",
        "name"
      ]
    },
    "UserInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Rai"
        },
        "email": {
          "type": "string",
          "example": "rai@mail.com"
        },
        "passwordHash": {
          "type": "string",
          "example": "123456"
        },
        "role": {
          "type": "string",
          "example": "customer"
        }
      }
    },
    "MenuItemInput": {
      "type": "object",
      "properties": {
        "stallId": {
          "type": "number",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Nasi Goreng"
        },
        "price": {
          "type": "number",
          "example": 15000
        },
        "isAvailable": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "ReviewInput": {
      "type": "object",
      "properties": {
        "stallId": {
          "type": "number",
          "example": 1
        },
        "userId": {
          "type": "number",
          "example": 1
        },
        "rating": {
          "type": "number",
          "example": 5
        },
        "comment": {
          "type": "string",
          "example": "Mantap!"
        }
      }
    },
    "LikeInput": {
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "number",
          "example": 1
        },
        "userId": {
          "type": "number",
          "example": 1
        }
      }
    },
    "FlagInput": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "resolved"
        }
      }
    },
    "AuditInput": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "number",
          "example": 1
        },
        "action": {
          "type": "string",
          "example": "LOGIN"
        },
        "targetTable": {
          "type": "string",
          "example": "users"
        },
        "targetId": {
          "type": "number",
          "example": 1
        },
        "details": {
          "type": "string",
          "example": "User logged in"
        }
      }
    }
  }
